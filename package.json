{
  "name": "radio-atlantida-frontend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^24.21.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "ng": "ng",
    "predev": "npm run api:generate",
    "dev": "ng serve",
    "start": "npm run dev",
    "prebuild": "npm run api:generate",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run api:generate",
    "test": "ng test --watch=false",
    "pretest:watch": "npm run api:generate",
    "test:watch": "ng test",
    "pretypecheck": "npm run api:generate",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:sync": "node scripts/sync-api.mjs",
    "api:generate": "openapi-typescript api/openapi.json --output src/app/core/api/generated/api.ts"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@eslint/js": "10.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
